table hou_consultantskill
	lineageTag: f0131109-0d81-40df-94e6-4dbbf388fdad

	measure 'Skill Supply' = ```
			
			        CALCULATE(DISTINCTCOUNT(hou_consultantskill[Consultant]), hou_consultantskill[Proficiency] >= 3)
			```
		formatString: 0
		lineageTag: 3f63716f-8751-4939-a503-34806f4a91e2

	measure 'Skill Demand' = ```
			
			        CALCULATE(SUM(hou_engagementskill[Headcount]), hou_engagement[Engagement Status] <> "Closed")
			```
		formatString: 0
		lineageTag: d3d082f6-7908-4f3d-8db9-df6f4a0e6134

	measure 'Skill Gap' = ```
			
			        [Skill Demand] - [Skill Supply]
			```
		formatString: 0
		lineageTag: ef2b63a3-a83d-4874-9771-9f13c97757e7

