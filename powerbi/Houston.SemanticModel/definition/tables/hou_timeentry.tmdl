table hou_timeentry
	lineageTag: 0e05fb74-0a14-4256-8cdc-4bc494a0f7b4

	measure 'Total Hours' = ```
			
			        SUM(hou_timeentry[Hours])
			```
		lineageTag: ea8bad5b-d400-4b07-9afe-f8becaf969ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Billable Hours' = ```
			
			        CALCULATE([Total Hours],
			            KEEPFILTERS(FILTER(VALUES(hou_timeentry[Billable]),
			                FORMAT(hou_timeentry[Billable], "") IN {"True", "Yes"})))
			```
		lineageTag: d9f95696-be10-4f6e-832d-68fcc46fadae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Capacity Hours' = ```
			
			        COUNTROWS(hou_timesheet) * 40
			```
		formatString: 0
		lineageTag: 714bf830-0037-4bf3-933c-56452819d96e

	measure 'Billable Utilisation %' = ```
			
			        DIVIDE([Billable Hours], [Capacity Hours])
			```
		lineageTag: 182e9305-cbd8-40b6-9551-bbbebe65763e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Target Utilisation %' = ```
			
			        DIVIDE(AVERAGE(hou_consultant[Target Utilisation]), 100)
			```
		lineageTag: fe429ab9-8c53-4a97-a797-6ac76be564f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Utilisation vs Target' = ```
			
			        [Billable Utilisation %] - [Target Utilisation %]
			```
		lineageTag: 8ae149a9-0112-4385-aab5-aa94b8896fc5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

