table hou_assignment
	lineageTag: cfba1602-eb12-4431-923d-96564625099b

	measure 'Forecast Allocation %' = ```
			
			        VAR wk = MAX(Weeks[Week Start])
			        RETURN IF(COUNTROWS(hou_consultant) = 0, BLANK(), DIVIDE(
			            SUMX(FILTER(hou_assignment,
			                hou_assignment[Start Date] <= wk && hou_assignment[End Date] >= wk),
			                hou_assignment[Allocation %]) + 0, 100))
			```
		formatString: 0%
		lineageTag: a7d77ba2-3e45-489e-aec0-8eafbe81fafe

	measure 'Consultants on Bench' = ```
			
			        COUNTROWS(FILTER(VALUES(hou_consultant[Consultant]), [Forecast Allocation %] = 0))
			```
		formatString: 0
		lineageTag: dd6066b6-7742-4a9d-a429-d5cffd437c81

