{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hou_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hou_approvals"
        },
        "api": {
          "name": "shared_approvals"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "metadata": {
            "operationMetadataId": "3a720b8d-38db-47cf-a625-0a66214c1611"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "hou_timesheet",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "hou_status",
              "subscriptionRequest/filterexpression": "hou_status eq 741000001"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Get_consultant": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "46ee5867-b03e-404a-af44-11ea45ee9e11"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "hou_consultants",
              "recordId": "@triggerOutputs()?['body/_hou_consultant_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_manager": {
          "runAfter": {
            "Get_consultant": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ab1281cf-000b-43c6-9965-762c2aca0c73"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "hou_consultants",
              "recordId": "@outputs('Get_consultant')?['body/_hou_manager_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Start_and_wait_for_an_approval": {
          "runAfter": {
            "Get_manager": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1e4e2bdf-853b-4d54-a5ee-071bfbdd51df"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_approvals",
              "operationId": "StartAndWaitForAnApproval",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
            },
            "parameters": {
              "approvalType": "Basic",
              "WebhookApprovalCreationInput/title": "Timesheet: @{triggerOutputs()?['body/hou_name']}",
              "WebhookApprovalCreationInput/assignedTo": ";",
              "WebhookApprovalCreationInput/details": "Approving on behalf of @{outputs('Get_manager')?['body/hou_name']}",
              "WebhookApprovalCreationInput/enableNotifications": true,
              "WebhookApprovalCreationInput/enableReassignment": true
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Condition": {
          "actions": {
            "Update_a_row": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "718ed7e9-040c-4b8f-9a23-0f3bc270f215"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "hou_timesheets",
                  "recordId": "@triggerOutputs()?['body/hou_timesheetid']",
                  "item/hou_status": 741000002,
                  "item/hou_Approver@odata.bind": "hou_consultants(@{outputs('Get_manager')?['body/hou_consultantid']})",
                  "item/hou_decisiondate": "@utcNow()"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Start_and_wait_for_an_approval": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Update_a_row_2": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "f0b8fa15-7e31-4d08-8927-d9e4cab7e3c6"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "UpdateOnlyRecord",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "hou_timesheets",
                    "recordId": "@triggerOutputs()?['body/hou_timesheetid']",
                    "item/hou_status": 741000003,
                    "item/hou_comment": "@first(body('Start_and_wait_for_an_approval')?['responses'])?['comments']",
                    "item/hou_decisiondate": "@utcNow()"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@outputs('Start_and_wait_for_an_approval')?['body/outcome']",
              "Approve"
            ]
          },
          "metadata": {
            "operationMetadataId": "e920b941-be0f-473c-8912-0917a1e2611f"
          },
          "type": "If"
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}